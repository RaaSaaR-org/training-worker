# Server + identity
NEODEM_SERVER_URL=http://192.168.178.76:3001
WORKER_ID=worker-mac-mps-01
POLL_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=30

# RustFS / S3 (on the Pi)
RUSTFS_ENDPOINT=http://192.168.178.76:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET_DATASETS=training-datasets
RUSTFS_BUCKET_MODELS=model-checkpoints

# Training
TRAINING_DEVICE=mps     # mps (Mac) | cuda (Linux GPU) | cpu
CHECKPOINT_INTERVAL_STEPS=100
HF_CACHE_DIR=~/.cache/neodem-worker

# GR00T N1.x trainer (jobs with baseModel containing "gr00t") — CUDA only.
# Clone + sync via scripts/setup-gr00t.sh, then point at the clone:
#GR00T_REPO_DIR=~/Isaac-GR00T
# Optional: python interpreter that already has gr00t installed (containers);
# replaces the default `uv run --project $GR00T_REPO_DIR python`:
#GR00T_PYTHON=/usr/bin/python3
# Optional: interpreter for the LeRobot v3→v2 converter, which needs lerobot
# (default: the converter's own uv env at $GR00T_REPO_DIR/scripts/lerobot_conversion,
# or GR00T_PYTHON if set):
#GR00T_CONVERTER_PYTHON=/usr/bin/python3
# Optional: progress/cancel poll interval in seconds (default 5):
#GR00T_PROGRESS_POLL_SEC=5

# Phase 1a — use stub trainer (fake training, proves the loop)
# Set to false in Phase 1b to use the real SmolVLA LoRA trainer
TRAINER_STUB=true
